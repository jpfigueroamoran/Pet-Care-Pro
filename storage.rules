rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pets_photos/{userId}/{fileName} {
      // Permitir subir si el usuario está autenticado y es el dueño del directorio, es una imagen y mide < 5MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Permitir leer a cualquier usuario autenticado (dueños, veterinarios, admins)
      allow read: if request.auth != null;
    }

    match /comprobantes/{userId}/{paymentId}/{fileName} {
      // Solo el dueño del pago puede subir su comprobante (máx 10MB, solo imágenes)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Cualquier usuario autenticado puede leer para validar (veterinario, admin)
      allow read: if request.auth != null;
    }
  }
}
